{
  "name": "flavor-code",
  "version": "1.3.19",
  "author": "YachuanWzh",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "dist/desktop/main.js",
  "bin": {
    "flavor": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/desktop/main.js",
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "README.zh-CN.md",
    "技术方案报告.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:icons && npm run build:cli && npm run build:desktop",
    "build:icons": "node scripts/build-icons.mjs",
    "build:cli": "tsup && tsc -p tsconfig.sdk.json && node -e \"require('fs').cpSync('src/init/astgraph','dist/astgraph',{recursive:true})\"",
    "build:desktop": "npm run build:desktop:main && npm run build:desktop:renderer",
    "build:desktop:main": "tsup --config tsup.desktop.config.ts",
    "build:desktop:renderer": "vite build --config vite.desktop.config.ts",
    "vscode:build": "tsup --config tsup.vscode.config.ts",
    "vscode:typecheck": "tsc --noEmit -p tsconfig.vscode.json",
    "ide:install": "node scripts/install-vscode-extension.mjs --ide auto",
    "qoder:install": "node scripts/install-vscode-extension.mjs --ide qoder",
    "vscode:install": "node scripts/install-vscode-extension.mjs --ide code",
    "desktop:dev": "npm run build:desktop:main && node scripts/desktop-dev.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "test:reliability": "vitest run tests/harness/journal.test.ts tests/context/manager.test.ts tests/session/store.test.ts tests/permissions/policy.test.ts tests/goal/classifier.test.ts tests/goal/orchestrator.test.ts",
    "test:watch": "vitest",
    "test:desktop:e2e": "npm run build:desktop && node tests/desktop/electron-app.e2e.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:install": "node scripts/smoke-install.mjs",
    "smoke:d2c-worker": "npm run build:desktop:main && node scripts/smoke-d2c-worker.mjs",
    "stress:context": "vitest run scripts/stress-context-memory.test.ts --reporter=verbose",
    "stress:production-memory": "npm run build:cli && node scripts/stress-production-memory.mjs",
    "evidence:crash-fix": "vitest run scripts/evidence-crash-replay.test.ts --reporter=verbose",
    "prepack": "npm run build"
  },
  "build": {
    "appId": "dev.flavorcode.desktop",
    "productName": "Flavor Code",
    "asar": true,
    "asarUnpack": [
      "dist/desktop/pixel-worker.js",
      "dist/desktop/plugin-worker-entry.js",
      "dist/desktop/pals-broker-entry.js"
    ],
    "icon": "assets/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "assets/icon.png",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Flavor-Code-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bidi-js": "^1.0.3",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "emoji-regex": "^10.6.0",
    "ignore": "^7.0.6",
    "ink": "^7.1.0",
    "lodash-es": "^4.17.23",
    "marked": "^16.4.2",
    "node-pty": "^1.1.0",
    "openai": "^6.46.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semver": "^7.7.4",
    "signal-exit": "4.1.0",
    "supports-hyperlinks": "^4.4.0",
    "typescript": "^7.0.2",
    "usehooks-ts": "^3.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "3.9.2",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "tree-sitter-wasms": "0.1.13",
    "tsup": "^8.5.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-tree-sitter": "0.25.10"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.27.7": true,
    "electron@42.7.0": true,
    "node-pty@1.1.0": true
  }
}
