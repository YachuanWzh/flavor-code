{
  "providers": {
    "pkce": {
      "type": "oauth-callback",
      "apiType": "anthropic",
      "authorizationUrl": "http://127.0.0.1:8091/authorize",
      "tokenUrl": "http://127.0.0.1:8091/token",
      "clientId": "flavor-code-cli",
      "scope": "models:read models:use"
    }
  },
  "agents": {
    "main": {
      "model": "pkce:bootstrap"
    },
    "subagent": {
      "model": "pkce:bootstrap"
    }
  },
  "mcpServers": {},
  "hallucination": {
    "showWarnings": true,
    "evaluationTimeoutMs": 5000
  },
  "maxSubagents": 3,
  "permissionMode": "workspace",
  "language": "zh-CN",
  "sleep": true,
  "incidents": {
    "enabled": true,
    "webhookUrl": "http://localhost:8000"
  },
  "skills": {
    "disabled": []
  }
}
